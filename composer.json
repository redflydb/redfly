{
    "name": "ubccr/redfly",
    "description": "The Regulatory Element Database for Drosophila",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Center for Computational Research, the University at Buffalo",
            "email": "ccr@buffalo.edu"
        }
    ],
    "require": {
        "doctrine/dbal": "4.4.3",
        "google/apiclient": "2.19.3",
        "google/recaptcha": "1.5",
        "guzzlehttp/guzzle": "7.10.0",
        "latitude/latitude": "2.3.1",
        "league/csv": "9.28.0",
        "league/json-guard": "1.0.1",
        "league/oauth2-google": "5.0.0",
        "monolog/monolog": "3.10.0",
        "paragonie/easydb": "3.1.1",
        "phpmailer/phpmailer": "7.0.2",
        "psr/http-message": "1.1",
        "psr/log": "3.0.2",
        "slim/slim": "3.13.0"
    },
    "require-dev": {
        "phpstan/phpstan": "2.1.54",
        "squizlabs/php_codesniffer": "4.0.1"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "CCR\\REDfly\\": "lib"
        },
        "classmap": [
            "lib/",
            "lib/api",
            "lib/ExportFile",
            "lib/ExtDatasource"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "CCR\\REDfly\\": "tests/unit/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.6",
            "ext-bcmath": "8.5.6"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
